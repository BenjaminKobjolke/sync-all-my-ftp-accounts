"""Central settings; every store location can be overridden via environment variables."""

import os
from dataclasses import dataclass
from pathlib import Path

from ftp_sync import constants


@dataclass(frozen=True)
class Settings:
    filezilla_path: Path
    nppftp_path: Path
    fman_path: Path
    winscp_key: str
    backup_dir: Path
    log_level: str = "INFO"

    @classmethod
    def from_env(cls) -> "Settings":
        appdata = Path(os.getenv(constants.ENV_APPDATA, ""))
        return cls(
            filezilla_path=_path(
                constants.ENV_FILEZILLA_PATH, appdata / constants.FILEZILLA_RELATIVE_PATH
            ),
            nppftp_path=_path(constants.ENV_NPPFTP_PATH, appdata / constants.NPPFTP_RELATIVE_PATH),
            fman_path=_path(constants.ENV_FMAN_PATH, appdata / constants.FMAN_RELATIVE_PATH),
            winscp_key=os.getenv(constants.ENV_WINSCP_KEY, constants.WINSCP_SESSIONS_KEY),
            backup_dir=_path(constants.ENV_BACKUP_DIR, Path(constants.DEFAULT_BACKUP_DIR)),
            log_level=os.getenv(constants.ENV_LOG_LEVEL, "INFO"),
        )


def _path(env_name: str, default: Path) -> Path:
    value = os.getenv(env_name)
    return Path(value) if value else default
===== src/ftp_sync/app_logger.py =====
"""The single logging entry point. Never pass passwords or credential URLs in."""

import logging
import sys

_LOGGER_NAME = "ftp_sync"


class AppLogger:
    _configured = False

    @classmethod
    def configure(cls, level: str = "INFO") -> None:
        handler = logging.StreamHandler(sys.stdout)
        handler.setFormatter(logging.Formatter("%(message)s"))
        logger = logging.getLogger(_LOGGER_NAME)
        logger.handlers = [handler]
        logger.setLevel(level.upper())
        logger.propagate = False
        cls._configured = True

    @classmethod
    def _logger(cls) -> logging.Logger:
        if not cls._configured:
            cls.configure()
        return logging.getLogger(_LOGGER_NAME)

    @classmethod
    def debug(cls, message: str) -> None:
        cls._logger().debug(message)

    @classmethod
    def info(cls, message: str) -> None:
        cls._logger().info(message)

    @classmethod
    def warning(cls, message: str) -> None:
        cls._logger().warning(f"WARNING: {message}")

    @classmethod
    def error(cls, message: str) -> None:
        cls._logger().error(f"ERROR: {message}")
===== src/ftp_sync/backup.py =====
"""Backs up each store once per run, right before its first write."""

import shutil
import subprocess
from datetime import datetime
from pathlib import Path

from ftp_sync.app_logger import AppLogger


class BackupCoordinator:
    def __init__(self, backup_root: Path) -> None:
        self._dir = backup_root / datetime.now().strftime("%Y%m%d_%H%M%S")
        self._done: set[str] = set()

    def backup_file(self, path: Path) -> None:
        if str(path) in self._done:
            return
        self._dir.mkdir(parents=True, exist_ok=True)
        target = self._dir / path.name
        shutil.copy2(path, target)
        self._done.add(str(path))
        AppLogger.info(f"Backup: {target}")

    def backup_registry(self, hkcu_key: str, file_name: str) -> None:
        if hkcu_key in self._done:
            return
        self._dir.mkdir(parents=True, exist_ok=True)
        target = self._dir / file_name
        subprocess.run(
            ["reg", "export", f"HKCU\\{hkcu_key}", str(target), "/y"],
            check=True,
            capture_output=True,
        )
        self._done.add(hkcu_key)
        AppLogger.info(f"Backup: {target}")
===== src/ftp_sync/account_matcher.py =====
"""Decides whether a source account already exists in a target store."""

from collections.abc import Iterable
from enum import StrEnum

from ftp_sync.models import FtpAccount


class MatchStatus(StrEnum):
    FOUND = "found"
    DIFFERENT_PASSWORD = "DIFFERENT PASSWORD"
    MISSING = "missing"
    UNSUPPORTED = "unsupported"


class AccountIndex:
    """Accounts of one store, looked up by FtpAccount.match_key()."""

    def __init__(self, accounts: Iterable[FtpAccount]) -> None:
        self._by_key: dict[tuple[str, str], list[FtpAccount]] = {}
        for account in accounts:
            self.add(account)

    def add(self, account: FtpAccount) -> None:
        self._by_key.setdefault(account.match_key(), []).append(account)

    def status_of(self, account: FtpAccount, supported: bool) -> MatchStatus:
        matches = self._by_key.get(account.match_key(), [])
        if any(m.password == account.password for m in matches):
            return MatchStatus.FOUND
        if matches:
            return MatchStatus.DIFFERENT_PASSWORD
        return MatchStatus.MISSING if supported else MatchStatus.UNSUPPORTED
===== src/ftp_sync/menu.py =====
"""The only place that talks to `pick`. Tests patch these functions, never pick itself."""

import sys

from pick import pick


def _require_tty() -> None:
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        raise RuntimeError("Interactive menu needs a console - run start.bat in a terminal")


def show_menu(options: list[str], title: str, default_index: int = 0) -> int:
    """Arrow-key menu; return the selected index. Ctrl-C exits."""
    _require_tty()
    try:
        _, index = pick(
            options=options,
            title=title,
            indicator="*",
            default_index=default_index,
            backend="blessed",  # curses breaks arrow keys on Windows after subprocesses
        )
        return int(index)
    except KeyboardInterrupt:
        sys.exit(1)


def show_multiselect(options: list[str], title: str) -> list[int]:
    """Space toggles, Enter confirms; return the selected indices."""
    _require_tty()
    try:
        selected = pick(
            options=options,
            title=title,
            indicator="*",
            multiselect=True,
            min_selection_count=0,
            backend="blessed",
        )
        return [int(index) for _, index in selected]
    except KeyboardInterrupt:
        sys.exit(1)
===== src/ftp_sync/sync_runner.py =====
"""Feature 1: walk every account of one source store and create it where it is missing."""

from collections import Counter
from collections.abc import Sequence
from dataclasses import dataclass, field
from enum import Enum

from ftp_sync import menu
from ftp_sync.account_matcher import AccountIndex, MatchStatus
from ftp_sync.app_logger import AppLogger
from ftp_sync.models import AppKind, FtpAccount
from ftp_sync.stores.account_store import AccountStore


class SyncAction(Enum):
    """Menu shown per account with missing targets; menu order = definition order."""

    CREATE_MISSING = "Create in all missing apps"
    CHOOSE = "Choose apps..."
    SKIP = "Skip this account"
    CREATE_ALL_REMAINING = "Create in all missing apps - for this and ALL remaining accounts"
    QUIT = "Quit"


@dataclass
class SyncSummary:
    created: Counter[AppKind] = field(default_factory=Counter)
    errors: Counter[AppKind] = field(default_factory=Counter)
    skipped: int = 0


@dataclass
class _Target:
    store: AccountStore
    index: AccountIndex


class SyncRunner:
    def __init__(self, stores: Sequence[AccountStore]) -> None:
        self._stores = [s for s in stores if s.is_available()]

    def run(self, source_kind: AppKind | None) -> SyncSummary:
        source = self._pick_source(source_kind)
        targets = [_Target(s, AccountIndex(s.load())) for s in self._stores if s is not source]
        summary = SyncSummary()
        create_all = False
        for account in source.load():
            missing = self._report(account, targets)
            if not missing:
                continue
            action = SyncAction.CREATE_MISSING if create_all else self._ask(account, missing)
            if action is SyncAction.QUIT:
                break
            if action is SyncAction.SKIP:
                summary.skipped += 1
                continue
            if action is SyncAction.CHOOSE:
                missing = self._choose(account, missing)
            create_all = create_all or action is SyncAction.CREATE_ALL_REMAINING
            self._create(account, missing, summary)
        self._log_summary(summary)
        return summary

    def _pick_source(self, source_kind: AppKind | None) -> AccountStore:
        if not self._stores:
            raise RuntimeError("No supported FTP app with stored accounts found")
        if source_kind is None:
            labels = [s.kind.label for s in self._stores]
            return self._stores[menu.show_menu(labels, "Sync FROM which app?")]
        for store in self._stores:
            if store.kind is source_kind:
                return store
        raise RuntimeError(f"{source_kind.label} is not installed or has no stored accounts")

    @staticmethod
    def _report(account: FtpAccount, targets: list[_Target]) -> list[_Target]:
        AppLogger.info(f"\n{account.describe()}")
        missing = []
        for target in targets:
            status = target.index.status_of(account, target.store.supports(account.protocol))
            AppLogger.info(f"    {target.store.kind.label:<20} {status.value}")
            if status is MatchStatus.MISSING:
                missing.append(target)
        return missing

    @staticmethod
    def _ask(account: FtpAccount, missing: list[_Target]) -> SyncAction:
        names = ", ".join(t.store.kind.label for t in missing)
        title = f"{account.describe()}\nMissing in: {names}"
        actions = list(SyncAction)
        return actions[menu.show_menu([a.value for a in actions], title)]

    @staticmethod
    def _choose(account: FtpAccount, missing: list[_Target]) -> list[_Target]:
        labels = [t.store.kind.label for t in missing]
        title = f"{account.describe()}\nCreate in (Space = toggle, Enter = confirm):"
        return [missing[i] for i in menu.show_multiselect(labels, title)]

    @staticmethod
    def _create(account: FtpAccount, targets: list[_Target], summary: SyncSummary) -> None:
        for target in targets:
            kind = target.store.kind
            try:
                target.store.add(account)
            except Exception as error:  # noqa: BLE001 - one failing app must not stop the run
                summary.errors[kind] += 1
                AppLogger.error(f"{kind.label}: could not create {account.describe()}: {error}")
                continue
            target.index.add(account)
            summary.created[kind] += 1
            AppLogger.info(f"    -> created in {kind.label}")

    @staticmethod
    def _log_summary(summary: SyncSummary) -> None:
        AppLogger.info("\n=== Summary ===")
        for kind in AppKind:
            if summary.created[kind] or summary.errors[kind]:
                AppLogger.info(
                    f"{kind.label:<20} created {summary.created[kind]}, "
                    f"errors {summary.errors[kind]}"
                )
        AppLogger.info(f"Skipped accounts: {summary.skipped}")
===== src/ftp_sync/main.py =====
"""CLI entry point and the central error handler."""

import argparse
import sys

from ftp_sync.app_logger import AppLogger
from ftp_sync.backup import BackupCoordinator
from ftp_sync.config.settings import Settings
from ftp_sync.models import AppKind
from ftp_sync.stores.registry import build_stores
from ftp_sync.sync_runner import SyncRunner


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Sync stored FTP accounts between apps")
    parser.add_argument("--source", choices=[k.value for k in AppKind], help="app to sync from")
    args = parser.parse_args(argv)

    settings = Settings.from_env()
    AppLogger.configure(settings.log_level)
    AppLogger.info("Close FileZilla and Notepad++ first - they overwrite their config on exit.")
    try:
        stores = build_stores(settings, BackupCoordinator(settings.backup_dir))
        SyncRunner(stores).run(AppKind(args.source) if args.source else None)
    except KeyboardInterrupt:
        return 1
    except Exception as error:  # noqa: BLE001 - central handler: report, never traceback-dump
        AppLogger.error(str(error))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
