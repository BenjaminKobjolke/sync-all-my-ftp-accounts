---MENU---
"""The only place that talks to `pick`. Tests patch these functions, never pick itself."""

import sys

from pick import pick


def _require_tty() -> None:
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        raise RuntimeError("Interactive menu needs a console - run start.bat in a terminal")


def show_menu(options: list[str], title: str, default_index: int = 0) -> int:
    """Arrow-key menu; return the selected index. Ctrl-C exits."""
    _require_tty()
    try:
        _, index = pick(
            options=options,
            title=title,
            indicator="*",
            default_index=default_index,
            backend="blessed",  # curses breaks arrow keys on Windows after subprocesses
        )
        return int(index)
    except KeyboardInterrupt:
        sys.exit(1)


def show_multiselect(options: list[str], title: str) -> list[int]:
    """Space toggles, Enter confirms; return the selected indices."""
    _require_tty()
    try:
        selected = pick(
            options=options,
            title=title,
            indicator="*",
            multiselect=True,
            min_selection_count=0,
            backend="blessed",
        )
        return [int(index) for _, index in selected]
    except KeyboardInterrupt:
        sys.exit(1)

---MODELS---
"""Domain types shared by every credential store."""

from dataclasses import dataclass
from enum import StrEnum

from ftp_sync import constants


class FtpProtocol(StrEnum):
    FTP = "ftp"
    FTPS = "ftps"
    SFTP = "sftp"

    @property
    def default_port(self) -> int:
        return (
            constants.SFTP_DEFAULT_PORT if self is FtpProtocol.SFTP else constants.FTP_DEFAULT_PORT
        )


class AppKind(StrEnum):
    WINSCP = "winscp"
    FILEZILLA = "filezilla"
    NPPFTP = "nppftp"
    FMAN = "fman"

    @property
    def label(self) -> str:
        return constants.APP_LABELS[self.value]


@dataclass(frozen=True)
class FtpAccount:
    """One stored site. `folder` uses '/' between nesting levels, '' for top level."""

    name: str
    host: str
    user: str
    password: str
    port: int
    protocol: FtpProtocol
    folder: str = ""
    remote_dir: str = ""

    def match_key(self) -> tuple[str, str]:
        # Port and protocol are ignored on purpose: the same login is often saved
        # as FTP in one app and FTPS in another.
        return (self.host.strip().lower(), self.user.strip().lower())

    def describe(self) -> str:
        """Display text without the password."""
        location = f"{self.folder}/{self.name}" if self.folder else self.name
        return f"{location}  ({self.protocol.value}://{self.user}@{self.host}:{self.port})"

